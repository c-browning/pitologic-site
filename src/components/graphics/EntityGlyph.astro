---
type EntityType = 'risk' | 'issue' | 'task' | 'milestone' | 'training' | 'procedure' | 'trial' | 'spec';

interface Props {
  type: EntityType;
  size?: number;
  color?: string;
  class?: string;
}
const { type, size = 22, color = 'currentColor', class: className } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['entity-glyph', `glyph-${type}`, className]}
  role="img"
  aria-label={type}
>
  {type === 'risk' && (
    <>
      <path d="M12 3 L21 20 L3 20 Z" />
      <line x1="12" y1="10" x2="12" y2="14" />
      <circle cx="12" cy="17" r="0.6" fill={color} stroke="none" />
    </>
  )}
  {type === 'issue' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="1.5" />
      <line x1="9" y1="9" x2="15" y2="15" />
      <line x1="15" y1="9" x2="9" y2="15" />
    </>
  )}
  {type === 'task' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <polyline points="8 12 11 15 16 9" />
    </>
  )}
  {type === 'milestone' && (
    <>
      <polygon points="12 3 21 12 12 21 3 12" />
      <circle cx="12" cy="12" r="2.5" fill={color} stroke="none" />
    </>
  )}
  {type === 'training' && (
    <>
      <path d="M3 9 L12 5 L21 9 L12 13 Z" />
      <path d="M7 11 L7 16 Q12 19 17 16 L17 11" />
    </>
  )}
  {type === 'procedure' && (
    <>
      <rect x="5" y="3" width="14" height="18" rx="1" />
      <line x1="8" y1="8" x2="16" y2="8" />
      <line x1="8" y1="12" x2="16" y2="12" />
      <line x1="8" y1="16" x2="13" y2="16" />
    </>
  )}
  {type === 'trial' && (
    <>
      <path d="M9 3 L9 9 L4 19 Q4 21 6 21 L18 21 Q20 21 20 19 L15 9 L15 3" />
      <line x1="8" y1="3" x2="16" y2="3" />
      <line x1="7" y1="14" x2="17" y2="14" />
    </>
  )}
  {type === 'spec' && (
    <>
      <path d="M7 3 L7 21 M17 3 L17 21" />
      <path d="M4 7 L20 7 M4 12 L20 12 M4 17 L20 17" stroke-dasharray="2 2" />
    </>
  )}
</svg>
