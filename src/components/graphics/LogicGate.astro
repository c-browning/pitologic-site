---
interface Props {
  size?: number;
  color?: string;
  variant?: 'and' | 'divider';
}
const { size = 32, color = 'currentColor', variant = 'and' } = Astro.props;
---
{variant === 'and' && (
  <svg
    width={size * 1.6}
    height={size}
    viewBox="0 0 52 32"
    fill="none"
    stroke={color}
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2,2 L2,30 Q28,30 28,16 Q28,2 2,2 Z" />
    <line x1="-10" y1="10" x2="2" y2="10" />
    <line x1="-10" y1="22" x2="2" y2="22" />
    <line x1="28" y1="16" x2="42" y2="16" />
    <path d="M36,11 L44,16 L36,21" />
  </svg>
)}

{variant === 'divider' && (
  <div class="divider" aria-hidden="true">
    <span class="line" />
    <svg width="48" height="28" viewBox="0 0 52 32" fill="none" stroke={color} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6,4 L6,28 Q28,28 28,16 Q28,4 6,4 Z" />
      <line x1="28" y1="16" x2="42" y2="16" />
      <path d="M36,11 L44,16 L36,21" />
    </svg>
    <span class="line" />
  </div>
)}

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    color: var(--rule);
  }
  .line {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
</style>
