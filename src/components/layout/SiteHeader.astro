---
import Container from './Container.astro';
import Wordmark from '../graphics/Wordmark.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/product', label: 'Product' },
  { href: '/solutions', label: 'Solutions' },
  { href: '/integrations', label: 'Integrations' },
  { href: '/pitfalls', label: 'Pitfalls' },
  { href: '/pricing', label: 'Pricing' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <Container width="wide">
    <div class="bar">
      <a href="/" class="brand" aria-label="Pitot Logic home">
        <Wordmark width={140} color="var(--ink)" />
      </a>
      <nav class="nav" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >{item.label}</a>
        ))}
      </nav>
      <a href="/#waitlist" class="btn btn-primary cta">Join waitlist</a>
      <button class="menu-toggle" aria-label="Toggle menu" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </Container>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    header?.classList.toggle('open');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 241, 0.92);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--rule-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    padding-block: var(--space-s);
  }
  .brand { display: inline-flex; color: var(--ink); }
  .nav {
    display: flex;
    gap: var(--space-l);
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    font-size: var(--step--1);
    color: var(--ink-soft);
    position: relative;
    padding-block: var(--space-2xs);
    transition: color var(--dur) var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after,
  .nav-link.active::after { transform: scaleX(1); }
  .nav-link.active { color: var(--ink); }
  .cta { font-size: var(--step--1); padding: 0.6em 1.1em; }

  .menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 8px;
  }
  .menu-toggle span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }

  @media (max-width: 900px) {
    .nav {
      position: absolute;
      top: 100%;
      left: 0; right: 0;
      flex-direction: column;
      background: var(--paper);
      padding: var(--space-l);
      gap: var(--space-m);
      border-bottom: 1px solid var(--rule);
      transform: translateY(-110%);
      opacity: 0;
      pointer-events: none;
      transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
    }
    .site-header.open .nav {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .menu-toggle { display: flex; }
    .cta { display: none; }
  }
</style>
