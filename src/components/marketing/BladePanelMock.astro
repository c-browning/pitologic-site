---
// Hero visual: a stylized representation of two stacked blade panels,
// echoing Runway's signature in-context editing pattern.
---
<div class="blade-mock" aria-hidden="true">
  <div class="window">
    <div class="chrome">
      <span></span><span></span><span></span>
      <p class="url">acme.pitotrunway.app / schedule</p>
    </div>
    <div class="canvas">
      <div class="rail">
        <div class="rail-item active">Schedule</div>
        <div class="rail-item">My work</div>
        <div class="rail-item">Risks</div>
        <div class="rail-item">Procedures</div>
        <div class="rail-item">Map</div>
      </div>
      <div class="timeline">
        <div class="row">
          <span class="row-label">Mobilization</span>
          <span class="bar bar-done" style="--start: 4%; --end: 28%;"></span>
        </div>
        <div class="row">
          <span class="row-label">BHS commissioning</span>
          <span class="bar bar-active" style="--start: 24%; --end: 56%;"></span>
        </div>
        <div class="row">
          <span class="row-label">Trial day 1</span>
          <span class="bar bar-driven" style="--start: 58%; --end: 72%;">
            <span class="cascade">› driven by IT cutover</span>
          </span>
        </div>
        <div class="row">
          <span class="row-label">Live operations</span>
          <span class="bar bar-future" style="--start: 76%; --end: 96%;"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="blade blade-1">
    <div class="blade-head">
      <span class="pill">Milestone</span>
      <span class="title">Trial day 1 — terminal C</span>
      <span class="close">×</span>
    </div>
    <div class="blade-tabs">
      <span class="tab active">Details</span>
      <span class="tab">Links</span>
      <span class="tab">Discussion</span>
      <span class="tab">History</span>
    </div>
    <div class="blade-body">
      <div class="field">
        <span class="label">Start</span>
        <span class="value">2026-08-14 <em>· driven by IT cutover</em></span>
      </div>
      <div class="field">
        <span class="label">Owner</span>
        <span class="value">Aaron Park</span>
      </div>
      <div class="field">
        <span class="label">Links</span>
        <span class="value chips">
          <span class="chip"><span class="dot risk"></span>Risk · BHS power tie-in</span>
          <span class="chip"><span class="dot task"></span>3 tasks</span>
        </span>
      </div>
    </div>
  </div>

  <div class="blade blade-2">
    <div class="blade-head">
      <span class="pill pill-risk">Risk</span>
      <span class="title">BHS power tie-in slip</span>
      <span class="close">×</span>
    </div>
    <div class="blade-body compact">
      <div class="field">
        <span class="label">Probability</span>
        <span class="value">3 · Likely</span>
      </div>
      <div class="field">
        <span class="label">Impact</span>
        <span class="value">4 · High</span>
      </div>
      <button class="ghost-btn">Promote to issue →</button>
    </div>
  </div>
</div>

<style>
  .blade-mock {
    position: relative;
    aspect-ratio: 5 / 4;
    width: 100%;
    isolation: isolate;
  }
  .window {
    position: absolute;
    inset: 0;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius-m);
    box-shadow: 0 30px 60px -30px rgba(11, 42, 74, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }
  .chrome > span:not(.url) {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--rule);
  }
  .chrome .url {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-mute);
    margin-left: auto;
    letter-spacing: 0.04em;
  }
  .canvas { display: flex; flex: 1; }
  .rail {
    width: 28%;
    border-right: 1px solid var(--rule-soft);
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--paper-soft);
  }
  .rail-item {
    font-size: 11px;
    padding: 6px 10px;
    color: var(--ink-mute);
    border-radius: var(--radius-s);
  }
  .rail-item.active {
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }
  .timeline {
    flex: 1;
    padding: 20px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 22px;
  }
  .row-label {
    width: 38%;
    font-size: 11px;
    color: var(--ink-soft);
  }
  .bar {
    position: absolute;
    left: calc(38% + 12px + var(--start));
    width: calc(var(--end) - var(--start));
    height: 8px;
    border-radius: 999px;
    top: 50%;
    transform: translateY(-50%);
  }
  .bar-done { background: var(--ink-soft); opacity: 0.5; }
  .bar-active { background: var(--accent); }
  .bar-driven { background: var(--accent-soft); border: 1px dashed var(--accent); }
  .bar-future { background: var(--rule); }
  .cascade {
    position: absolute;
    top: -16px; left: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Blade panels — stacked editing context */
  .blade {
    position: absolute;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius-m);
    box-shadow: 0 24px 50px -20px rgba(11, 42, 74, 0.5);
    overflow: hidden;
  }
  .blade-1 {
    width: 52%;
    top: 18%;
    right: -4%;
    z-index: 2;
    animation: floatIn 0.7s var(--ease) 0.2s both;
  }
  .blade-2 {
    width: 38%;
    top: 38%;
    right: -10%;
    z-index: 3;
    animation: floatIn 0.7s var(--ease) 0.4s both;
  }
  @keyframes floatIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .blade-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--rule);
    background: var(--cream);
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
  }
  .pill-risk { background: var(--danger); }
  .title { font-size: 12px; font-weight: 500; flex: 1; }
  .close { font-size: 16px; color: var(--ink-mute); line-height: 1; }

  .blade-tabs {
    display: flex;
    gap: 14px;
    padding: 0 14px;
    border-bottom: 1px solid var(--rule-soft);
  }
  .tab {
    font-size: 10px;
    color: var(--ink-mute);
    padding: 8px 0;
    border-bottom: 1.5px solid transparent;
  }
  .tab.active { color: var(--ink); border-color: var(--accent); }

  .blade-body {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .blade-body.compact { gap: 6px; }
  .field { display: flex; gap: 10px; font-size: 11px; align-items: baseline; }
  .label {
    width: 70px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .value { flex: 1; color: var(--ink); }
  .value em { font-style: normal; color: var(--accent); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.04em; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-size: 10px;
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; }
  .dot.risk { background: var(--danger); }
  .dot.task { background: var(--success); }
  .ghost-btn {
    margin-top: 6px;
    align-self: flex-start;
    font-size: 10px;
    color: var(--accent);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .blade-1 { right: 2%; }
    .blade-2 { right: -4%; }
  }
</style>
