---
interface Props {
  eyebrow?: string;
  title: string;
  reverse?: boolean;
}
const { eyebrow, title, reverse = false } = Astro.props;
---
<div class:list={['split', { reverse }]}>
  <div class="copy stack-l">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="display step-3">{title}</h2>
    <div class="body">
      <slot name="body" />
    </div>
    <slot name="cta" />
  </div>
  <div class="visual">
    <slot name="visual" />
  </div>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .split.reverse .copy { order: 2; }
  .step-3 { font-size: var(--step-3); }
  .body { color: var(--ink-soft); font-size: var(--step-0); line-height: 1.55; }
  .body :global(p + p) { margin-top: var(--space-s); }
  @media (max-width: 900px) {
    .split, .split.reverse { grid-template-columns: 1fr; gap: var(--space-l); }
    .split.reverse .copy { order: 1; }
  }
</style>
