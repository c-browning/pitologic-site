---
interface Props {
  eyebrow?: string;
  align?: 'left' | 'center';
}
const { eyebrow, align = 'left' } = Astro.props;
---
<div class:list={['hero', `align-${align}`]}>
  <div class="copy stack-l">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <slot name="headline" />
    <slot name="sub" />
    <div class="cta cluster">
      <slot name="cta" />
    </div>
    <slot name="footnote" />
  </div>
  <div class="visual">
    <slot name="visual" />
  </div>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .align-center { grid-template-columns: 1fr; text-align: center; }
  .align-center .cta { justify-content: center; }
  .copy { max-width: 38rem; }
  .align-center .copy { margin-inline: auto; }
  .cta { margin-top: var(--space-s); }
  .visual { position: relative; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>
