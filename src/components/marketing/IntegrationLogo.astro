---
type Logo = 'entra' | 'outlook' | 'teams' | 'sharepoint' | 'excel' | 'azure';
interface Props {
  name: Logo;
  label?: string;
}
const { name, label } = Astro.props;
const display = label ?? name;
---
<div class="logo" title={display}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    {name === 'entra' && (
      <>
        <path d="M16 4 L28 26 H4 Z" fill="#0078D4" />
        <path d="M16 12 L22 24 H10 Z" fill="#50E6FF" />
      </>
    )}
    {name === 'outlook' && (
      <>
        <rect x="4" y="8" width="18" height="16" rx="2" fill="#0072C6" />
        <circle cx="13" cy="16" r="4" fill="#FAF7F1" />
        <circle cx="13" cy="16" r="2" fill="#0072C6" />
        <path d="M22 12 L28 16 L28 22 L22 18 Z" fill="#1F8DD6" />
      </>
    )}
    {name === 'teams' && (
      <>
        <rect x="4" y="9" width="14" height="14" rx="2" fill="#5059C9" />
        <text x="11" y="20" font-family="Arial" font-weight="700" font-size="11" fill="#FAF7F1" text-anchor="middle">T</text>
        <circle cx="23" cy="11" r="4" fill="#7B83EB" />
      </>
    )}
    {name === 'sharepoint' && (
      <>
        <circle cx="12" cy="14" r="7" fill="#038387" />
        <circle cx="20" cy="20" r="5" fill="#03787C" />
        <text x="12" y="18" font-family="Arial" font-weight="700" font-size="9" fill="#FAF7F1" text-anchor="middle">S</text>
      </>
    )}
    {name === 'excel' && (
      <>
        <rect x="4" y="6" width="24" height="20" rx="2" fill="#107C41" />
        <text x="16" y="22" font-family="Arial" font-weight="700" font-size="14" fill="#FAF7F1" text-anchor="middle">X</text>
      </>
    )}
    {name === 'azure' && (
      <>
        <path d="M12 5 L22 5 L28 27 L14 27 L19 14 L9 27 L4 27 Z" fill="#0078D4" />
      </>
    )}
  </svg>
  <span class="label">{display}</span>
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    background: var(--paper);
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: capitalize;
    color: var(--ink-soft);
  }
  :global(.surface-ink) .logo {
    background: rgba(244, 239, 230, 0.05);
    border-color: rgba(244, 239, 230, 0.18);
  }
  :global(.surface-ink) .label { color: rgba(244, 239, 230, 0.8); }
</style>
