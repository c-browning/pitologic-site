---
interface Props {
  num: string;
  title: string;
  href?: string;
}
const { num, title, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={['pillar', { 'is-link': !!href }]}>
  <span class="num">{num}</span>
  <h3 class="title">{title}</h3>
  <div class="body">
    <slot />
  </div>
  {href && <span class="more" aria-hidden="true">Read more →</span>}
</Tag>

<style>
  .pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    position: relative;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .pillar.is-link:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
  }
  .body {
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.5;
  }
  .more {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--accent);
    text-transform: uppercase;
  }
  :global(.surface-cream) .pillar { background: var(--paper); }
  :global(.surface-ink) .pillar {
    background: var(--ink-soft);
    border-color: rgba(244, 239, 230, 0.18);
  }
  :global(.surface-ink) .pillar .title { color: var(--paper); }
  :global(.surface-ink) .pillar .body { color: rgba(244, 239, 230, 0.8); }
</style>
