---
interface Props {
  attribution?: string;
  role?: string;
}
const { attribution, role } = Astro.props;
---
<blockquote class="quote">
  <p class="text"><slot /></p>
  {(attribution || role) && (
    <footer class="cite">
      {attribution && <span class="attr">— {attribution}</span>}
      {role && <span class="role">{role}</span>}
    </footer>
  )}
</blockquote>

<style>
  .quote {
    padding: var(--space-xl);
    border-left: 2px solid var(--accent);
    background: var(--cream);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
  }
  .text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .cite {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .attr { font-size: var(--step--1); color: var(--ink); font-weight: 500; }
  .role { font-family: var(--font-mono); font-size: var(--step--2); letter-spacing: 0.05em; color: var(--ink-mute); }
</style>
