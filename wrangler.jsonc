{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pitotlogic-site",
	"compatibility_date": "2026-04-24",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
